#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ "$1" = "--fix" ]; then
  echo "==> Running lints with --fix"
  .venv/bin/ruff check --fix .
else
  echo "==> Running lints"
  .venv/bin/ruff check .
  PATH="$PWD/.venv/bin:$PATH" ./scripts/run-pyright
  .venv/bin/mypy .
fi

echo "==> Making sure it imports"
.venv/bin/python -c 'import openai'
