{
  "include": [
    "../tests/api_resources",
    "../tests/test_client.py",
    "../tests/test_response.py",
    "../tests/test_legacy_response.py"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.10",
  "reportImplicitOverride": true,
